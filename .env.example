# Copy to .env and adjust. Compose reads this file automatically.
# .env is gitignored, so hostnames and mail addresses stay out of the repo.

# ---------------------------------------------------------------------------
# Reverse proxy (nginx-proxy + docker-gen + acme-companion)
# ---------------------------------------------------------------------------
# Every hostname below must resolve to the reverse proxy, over A *and* AAAA.
# Let's Encrypt validates HTTP-01 against both, and a client that falls back to
# IPv4 will hit whatever is on the A record. Check before enabling:
#
#   python3 -c "import socket;print(sorted({a[4][0] for a in \
#     socket.getaddrinfo('lorawan.example.com',None,socket.AF_INET)}))"
#
# Leave a value empty to keep that service off the proxy, docker-gen ignores an
# empty VIRTUAL_HOST.
#
# Keep both hostnames one label below the parent domain. A wildcard certificate
# for *.example.com covers lorawan.example.com but not api.lorawan.example.com,
# and acme-companient here has no DNS provider credentials, so it can only issue
# per-hostname certificates over HTTP-01.

# ChirpStack web UI and gRPC API, container port 8080.
VIRTUAL_HOST_CHIRPSTACK=lorawan.example.com
LETSENCRYPT_HOST_CHIRPSTACK=lorawan.example.com

# ChirpStack REST API, container port 8090. This one runs --insecure, so put a
# password file in place before enabling it. See docs/nginx-integration.md.
VIRTUAL_HOST_CHIRPSTACK_REST=lorawan-api.example.com
LETSENCRYPT_HOST_CHIRPSTACK_REST=lorawan-api.example.com

# Registration address for Let's Encrypt.
LETSENCRYPT_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Published ports
# ---------------------------------------------------------------------------
# 8080, 8090 and 1883 are not published at all, see docs/nginx-integration.md.

# Semtech UDP forwarder port. Only remote gateways need this, the on-host
# SX1302 talks to the bridge over the compose network. Bind it to a single LAN
# address rather than 0.0.0.0 if you keep it.
SEMTECH_UDP_BIND=0.0.0.0

# Basic Station backend port. Unused unless you deploy a separate Basic
# Station node, and the backend is configured without TLS.
BASIC_STATION_BIND=0.0.0.0
