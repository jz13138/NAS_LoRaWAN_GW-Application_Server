# Copy to .env and adjust. Compose reads this file automatically.
# .env is gitignored, so hostnames and mail addresses stay out of the repo.

# ---------------------------------------------------------------------------
# Reverse proxy (nginx-proxy + docker-gen + acme-companion)
# ---------------------------------------------------------------------------
# Every hostname below needs a DNS A record pointing at the reverse proxy,
# otherwise the ACME HTTP-01 challenge fails. Leave a value empty to keep that
# service off the proxy; docker-gen ignores an empty VIRTUAL_HOST.

# ChirpStack web UI and gRPC API, container port 8080.
VIRTUAL_HOST_CHIRPSTACK=chirp.example.com
LETSENCRYPT_HOST_CHIRPSTACK=chirp.example.com

# ChirpStack REST API, container port 8090. This one runs --insecure, so put a
# password file in place before enabling it. See docs/nginx-integration.md.
VIRTUAL_HOST_CHIRPSTACK_REST=api.chirp.example.com
LETSENCRYPT_HOST_CHIRPSTACK_REST=api.chirp.example.com

# Registration address for Let's Encrypt.
LETSENCRYPT_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Published ports
# ---------------------------------------------------------------------------
# 8080, 8090 and 1883 are not published at all, see docs/nginx-integration.md.

# Semtech UDP forwarder port. Only remote gateways need this, the on-host
# SX1302 talks to the bridge over the compose network. Bind it to a single LAN
# address rather than 0.0.0.0 if you keep it.
SEMTECH_UDP_BIND=0.0.0.0

# Basic Station backend port. Unused unless you deploy a separate Basic
# Station node, and the backend is configured without TLS.
BASIC_STATION_BIND=0.0.0.0
